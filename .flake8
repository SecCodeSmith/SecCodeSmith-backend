[flake8]
max-line-length = 127
max-complexity = 10
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    migrations,
    .pytest_cache,
    node_modules,
    .github

ignore =
    E203,  # whitespace before ':'
    W503,  # line break before binary operator
    E501,  # line too long (handled by black)

per-file-ignores =
    __init__.py:F401
    */settings.py:E501,F401
    */migrations/*.py:E501,F401
